# /etc/systemd/system/stonkflyrh-worker.service
#
# The trading worker. A network failure makes it back off and retry; if it
# still dies, systemd restarts it a minute later and `start` resumes. A halt
# that needs a person (loss stop, unresolved order, moved balance) makes
# `start` print why and exit cleanly, which systemd does not restart.
[Unit]
Description=StonkFlyRH trading worker (Robinhood Chain, live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stonkfly
WorkingDirectory=/opt/stonkflyrh
EnvironmentFile=/opt/stonkflyrh/.env
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/stonkflyrh/.venv/bin/python -m stonkflyrh start
Restart=on-failure
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=-/opt/stonkflyrh/runs -/opt/stonkflyrh/keystore -/opt/stonkflyrh/data
# Sized for an 8 GB droplet with the installer's 8 GB swapfile. On a 16 GB
# machine raise MemoryMax to 14G.
MemoryMax=6800M
MemorySwapMax=8G

[Install]
WantedBy=multi-user.target

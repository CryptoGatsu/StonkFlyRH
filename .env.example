# StonkFlyRH — the only file you need to edit.
# Copy to .env, fill in, then: python -m stonkflyrh start   (or start the systemd unit)

# --- What to run --------------------------------------------------------------
# paper   real Robinhood Chain prices and the real rug screen, simulated fills (start here)
# live    real swaps from the fly wallet
# fixture offline synthetic prices, no chain at all
STONKFLYRH_MODE=paper

# Dollar sizing. Capital is a cap: live preflight refuses a wallet funded past it.
STONKFLYRH_CAPITAL_USD=100
STONKFLYRH_ORDER_USD=10
# Most a buy may cost to round-trip (pool fee both ways plus impact), as a
# fraction. Pons pools charge about 3% a side, so below 0.07 nothing is bought.
STONKFLYRH_SPREAD_LIMIT=0.10

# Seed tokens, by symbol as listed in tokens.json. Optional: leave empty and
# discovery fills the universe from new USDG pools on the Uniswap factory, up to
# max_products, each one screened first.
STONKFLYRH_PRODUCTS=

# --- Your coin ----------------------------------------------------------------
# Shown on the site, looked at first by discovery, and admitted past the
# universe cap once its pool appears and clears the screen.
STONKFLYRH_COIN_ADDRESS=0xF12F616a0c02ee0dB385e0077D54cc07583676cB

# --- Wallets ------------------------------------------------------------------
# The fly wallet: holds USDG and gas ETH, signs every swap. Fund it with USDG and
# ETH only; launch your own coin from a different wallet.
STONKFLYRH_FLY_WALLET=0x68e82397455232f6F726E44ad1c980C6C99B3201
# Where swept protocol fees go (protocol_fee_bps defaults to 0).
STONKFLYRH_FEE_WALLET=0x7f5afC67d4C3AE0182354ea6e785FdEb20150f15

# The fly wallet's private key, for the FIRST live start only. `start` encrypts
# it into keystore/ and tells you to delete this line. It must derive the
# address above or nothing is written.
# STONKFLYRH_PRIVATE_KEY=
# Password for that keystore. Required for unattended live runs.
# STONKFLYRH_KEYSTORE_PASSWORD=

# --- Live opt-in -----------------------------------------------------------------
# Real swaps need this exact value AND STONKFLYRH_MODE=live.
# STONKFLYRH_LIVE=I_ACCEPT_REAL_ONCHAIN_TRADES

# --- Donations (on) ----------------------------------------------------------
# USDG sent to the fly wallet is a donor stake; donors are paid a share of gains
# above their high-water mark. Live runs only; paper shows the panel as "not
# accepting yet". Read docs/donations.md. Set 0 to turn off.
STONKFLYRH_DONATIONS=1
STONKFLYRH_DONOR_SHARE=0.5
STONKFLYRH_MAX_POOL_USD=1000

# --- Airdrops (off) -----------------------------------------------------------
# The fly sends your coin from the DEPLOYER wallet to wallets that bought tokens
# its screen approved and still hold one. Contracts, routers, pools, the fly's
# own wallets and anyone already dropped are never recipients. Needs
# STONKFLYRH_COIN_ADDRESS above and the deployer wallet's key (first start only,
# same one-time import as the fly wallet; delete the line afterwards). Paper
# runs only report who would receive. Read docs/airdrop.md.
STONKFLYRH_AIRDROP=0
STONKFLYRH_DEPLOYER_WALLET=0x89a813e1Eb38d38EEBd1Fb91EdD464E6fCC22f25
# STONKFLYRH_DEPLOYER_PRIVATE_KEY=
STONKFLYRH_AIRDROP_AMOUNT=1000            # coins per wallet
STONKFLYRH_AIRDROP_PER_ROUND=5            # wallets per round
STONKFLYRH_AIRDROP_INTERVAL_SECONDS=3600  # a round an hour
STONKFLYRH_AIRDROP_DAILY_CAP=50000        # coins per 24h, all rounds
STONKFLYRH_AIRDROP_RESERVE=0              # coins the deployer wallet always keeps

# --- Rarely changed -----------------------------------------------------------
STONKFLYRH_NETWORK=robinhood-mainnet
STONKFLYRH_TOKENS=tokens.json
STONKFLYRH_KEYSTORE=keystore
# STONKFLYRH_RPC_URL=            # override the public RPC; chain id is verified anyway
# STONKFLYRH_SCREEN=1            # 0 disables the rug screen (do not)
# STONKFLYRH_ADAPT=1             # 0 disables volatility sizing and loss cooldowns
# STONKFLYRH_DISCOVERY=1         # 0 trades only STONKFLYRH_PRODUCTS
# STONKFLYRH_FROZEN=0            # 1 freezes synaptic learning, for a control run
# STONKFLYRH_DATA=data           # where the MaleCNS files live

# Copy to .env and fill in locally. .env, keystore/ and tokens.json are git-ignored.

# --- Wallets ---------------------------------------------------------------
# The fly wallet: holds the run's WETH and gas, signs every swap. An imported
# key must derive this address or nothing is written.
STONKFLYRH_FLY_WALLET=0x68e82397455232f6F726E44ad1c980C6C99B3201
# Where swept protocol fees go. protocol_fee_bps defaults to 0.
STONKFLYRH_FEE_WALLET=0x7f5afC67d4C3AE0182354ea6e785FdEb20150f15
# Keystore directory written by: python -m stonkflyrh wallet import
STONKFLYRH_KEYSTORE=keystore
# Leave unset to be prompted. Setting it puts the password in your environment.
# STONKFLYRH_KEYSTORE_PASSWORD=
# For one unattended `wallet import` only; unset it afterwards.
# STONKFLYRH_PRIVATE_KEY=

# --- Network ---------------------------------------------------------------
# robinhood-mainnet (chain 4663) or robinhood-testnet (chain 46630). Nothing else.
STONKFLYRH_NETWORK=robinhood-mainnet
# Optional RPC override. The chain id is verified on connect either way.
# STONKFLYRH_RPC_URL=

# --- Contract registry -----------------------------------------------------
# Addresses you verified yourself. Copy tokens.example.json and fill it in.
STONKFLYRH_TOKENS=tokens.json

# --- Live execution --------------------------------------------------------
# Real swaps require this exact opt-in AND the --live flag.
STONKFLYRH_LIVE=I_ACCEPT_REAL_ONCHAIN_TRADES

# --- Posting to X ----------------------------------------------------------
# Every post is drafted to runs/<mode>/posts.jsonl regardless. Sending needs
# all four credentials AND the opt-in. An X developer app with write access
# provides them; they are used to sign requests and never logged.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# STONKFLYRH_POST_TO_X=1

# Optional location of verified MaleCNS files:
# STONKFLYRH_DATA=data
